NODE_ENV=development
PORT=3000

# PostgreSQL (via Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greg_ai_habits

# Supabase (infrastructure layer only — never used directly in business logic)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public keys exposed to the browser (Next.js NEXT_PUBLIC_ convention)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
